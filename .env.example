# Exchange selection: backpack | binance | bybit | okx | kraken | hyperliquid (default: backpack)
EXCHANGE=backpack

# Backpack (when EXCHANGE=backpack) - multi-account: list names, then per-account keys
# Webhook body can include "name": "main" or "name": "sub" to choose account
BACKPACK_ACCOUNTS=main,sub
BACKPACK_MAIN_API_KEY=
BACKPACK_MAIN_SECRET_KEY=
BACKPACK_SUB_API_KEY=
BACKPACK_SUB_SECRET_KEY=

# Binance (when EXCHANGE=binance)
# BINANCE_APIKEY=
# BINANCE_SECRET=

# Bybit (when EXCHANGE=bybit)
# BYBIT_APIKEY=
# BYBIT_SECRET=

# OKX (when EXCHANGE=okx)
# OKX_APIKEY=
# OKX_SECRET=
# OKX_PASSPHRASE=

# Kraken (when EXCHANGE=kraken)
# KRAKEN_API_KEY=
# KRAKEN_SECRET=

# Hyperliquid (when EXCHANGE=hyperliquid) - wallet address + private key
# HYPERLIQUID_APIKEY=
# HYPERLIQUID_SECRET=

# Optional: use CCXT sandbox/testnet when supported
# CCXT_SANDBOX=false

PORT=3000
MONGODB_URI=mongodb://localhost:27017/lifechange-dev
